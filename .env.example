# ── Orchestrator ──────────────────────────────────────────────────────────────
ORCHESTRATOR_CONFIG=./orchestrator.yaml
ORCHESTRATOR_DB=./data/orchestrator.sqlite
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=7777
LOG_LEVEL=info

# ── Claude ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── GitHub (used by `gh` for draft PRs; `gh auth setup-git` must have been run)
GH_TOKEN=

# ── Board credentials ─────────────────────────────────────────────────────────
# orchestrator.yaml never holds a secret; each project names a credential REF
# (board.credentials: TRELLO_MAIN) which resolves to <REF>_API_KEY + <REF>_TOKEN.
TRELLO_MAIN_API_KEY=
TRELLO_MAIN_TOKEN=
# Only needed for webhooks. This is the OAuth SECRET shown next to your API key
# at https://trello.com/power-ups/admin — it is neither the key nor the token.
TRELLO_MAIN_API_SECRET=

# ── Webhooks (optional; see docs/webhooks.md) ─────────────────────────────────
# The public URL changes every time you restart a dev tunnel, which is why it
# lives here and not in orchestrator.yaml.
ORCHESTRATOR_WEBHOOK_HOST=127.0.0.1
ORCHESTRATOR_WEBHOOK_PORT=7788
ORCHESTRATOR_WEBHOOK_PUBLIC_URL=
ORCHESTRATOR_WEBHOOK_PATH_PREFIX=/hooks/trello
# Any unguessable string; it becomes a segment of the public callback URL.
ORCHESTRATOR_WEBHOOK_PATH_SECRET=
