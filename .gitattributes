# Normalize all text files to LF in the repository. The maintainer develops on
# Windows; enforcing LF keeps Husky hooks, Docker builds and CI consistent.
* text=auto eol=lf

*.sh   text eol=lf
*.bash text eol=lf
.husky/* text eol=lf

Dockerfile          text eol=lf
*.Dockerfile        text eol=lf
.dockerignore       text eol=lf
docker-compose*.yml text eol=lf

# Windows-native scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

pnpm-lock.yaml -diff linguist-generated

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.sqlite binary
*.db     binary
