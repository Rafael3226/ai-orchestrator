{
  "name": "ai-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Board-driven AI dev team: role agents run Claude Code in isolated git worktrees, report back to Trello, and show up in a 2D office.",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "orchestrator": "./dist/index.js"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "clean": "rimraf dist coverage .tsbuildinfo",
    "dev": "tsx src/index.ts",
    "orchestrator": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:docker": "node scripts/test-docker.mjs",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.273",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "fastify": "^5.12.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ulid": "^3.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.5",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "better-sqlite3",
      "@anthropic-ai/claude-agent-sdk"
    ]
  }
}
